{
  "name": "senderplus",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@senderplus/customer-web --",
    "dev:customer": "npm run dev --workspace=@senderplus/customer-web --",
    "build": "npm run build:customer",
    "build:customer": "npm run build --workspace=@senderplus/customer-web",
    "lint": "npm run lint --workspaces --if-present",
    "preview": "npm run preview --workspace=@senderplus/customer-web --",
    "test": "npm run test:customer && npm run test:backend",
    "test:customer": "npm run test --workspace=@senderplus/customer-web",
    "test:backend": "python scripts/test_backend.py",
    "quality-gate": "npm run lint && npm test && npm run build"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5"
  }
}
